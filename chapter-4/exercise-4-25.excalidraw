      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKs",
      "roundness": null,
      "seed": 362018317,
      "version": 11,
      "versionNonce": 609408387,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782399818393,
      "link": null,
      "locked": false,
      "text": "\nException because the unless function is not a special form, it will evaluate all of\nits arguments before applying the function. This means that when we call (factorial 1), the\nunless function will evaluate both (* n (factorial (- n 1))) and 1, leading to an infinite\nrecursion as it tries to compute (factorial 0) and so on.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nException because the unless function is not a special form, it will evaluate all of\nits arguments before applying the function. This means that when we call (factorial 1), the\nunless function will evaluate both (* n (factorial (- n 1))) and 1, leading to an infinite\nrecursion as it tries to compute (factorial 0) and so on.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
