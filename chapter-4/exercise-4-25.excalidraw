      "updated": 1782399634895,
      "link": null,
      "locked": false,
      "text": "\nExercise 4.25: Suppose that (in ordinary applicative-order Scheme) we define unless as\nshown above and then define factorial in terms of unless as:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nExercise 4.25: Suppose that (in ordinary applicative-order Scheme) we define unless as\nshown above and then define factorial in terms of unless as:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PheM3T56pQnAa8DWjYMCw",
      "type": "text",
      "x": 605,
      "y": 295.5,
      "width": 253.86666870117188,
      "height": 125,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKp",
      "roundness": null,
      "seed": 2048866979,
      "version": 6,
      "versionNonce": 1222794435,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782399772472,
      "link": null,
      "locked": false,
      "text": "\n(define (factorial n)\n    (unless (= n 1)\n            (* n (factorial (- n 1)))\n            1))",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n(define (factorial n)\n    (unless (= n 1)\n            (* n (factorial (- n 1)))\n            1))",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
