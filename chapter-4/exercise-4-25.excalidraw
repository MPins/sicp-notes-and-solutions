      "groupIds": [],
      "frameId": null,
      "index": "bKk",
      "roundness": null,
      "seed": 857843757,
      "version": 227,
      "versionNonce": 1438675203,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782399860713,
      "link": null,
      "locked": false,
      "text": "Yes, our definitions will work in a normal-order language. In a normal-order language,\nthe arguments to a function are not evaluated until they are actually needed. This means that when\nwe call (factorial 1), the unless function will not evaluate (* n (factorial (- n 1))) until it is\nneeded, which will prevent the infinite recursion and allow the factorial function to return the\ncorrect result of 1.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Yes, our definitions will work in a normal-order language. In a normal-order language,\nthe arguments to a function are not evaluated until they are actually needed. This means that when\nwe call (factorial 1), the unless function will not evaluate (* n (factorial (- n 1))) until it is\nneeded, which will prevent the infinite recursion and allow the factorial function to return the\ncorrect result of 1.",
      "autoResize": true,
      "lineHeight": 1.25
    },
