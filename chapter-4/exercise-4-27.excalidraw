    {
      "id": "0gtPy5cjPygUnq2oW4DvF",
      "type": "text",
      "x": 656,
      "y": 487.5,
      "width": 887.316650390625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
