      "isDeleted": true,
      "boundElements": null,
      "updated": 1782405425886,
      "link": null,
      "locked": false,
      "text": "What happens if we atempt to evaluate (factorial 5)?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What happens if we atempt to evaluate (factorial 5)?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
