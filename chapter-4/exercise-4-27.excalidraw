    {
      "id": "XfznkpXvhHnC_DBKqfkhb",
      "type": "text",
      "x": 575,
      "y": 624.4375,
      "width": 904.0166625976562,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
