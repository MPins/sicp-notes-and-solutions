    {
      "id": "TISkFXolPu2k_wRVzNrjo",
      "type": "text",
      "x": 389.4261363636362,
      "y": 533.488636363636,
      "width": 910.6500244140625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
