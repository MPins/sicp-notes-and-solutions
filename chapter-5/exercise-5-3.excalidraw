      "text": "(controller\n    sqrt-loop\n        (assign x (op read))\n        (assign g (const 1.0))\n    test-ge\n        (assign t (op mul) (reg g) (reg g))\n        (assign t (op sub) (reg t) (reg x))\n        (assign t (op abs) (reg t))\n        (test (op <) (reg t) (const 0.00001))\n        (branch (label sqrt-done))\n        (assign t (op div) (reg x) (reg g))\n        (assign g (op average) (reg t) (reg g))\n        (goto (label test-ge))\n    sqrt-done\n        (perform (op print) (reg g))\n        (goto (label sqrt-loop)))",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(controller\n    sqrt-loop\n        (assign x (op read))\n        (assign g (const 1.0))\n    test-ge\n        (assign t (op mul) (reg g) (reg g))\n        (assign t (op sub) (reg t) (reg x))\n        (assign t (op abs) (reg t))\n        (test (op <) (reg t) (const 0.00001))\n        (branch (label sqrt-done))\n        (assign t (op div) (reg x) (reg g))\n        (assign g (op average) (reg t) (reg g))\n        (goto (label test-ge))\n    sqrt-done\n        (perform (op print) (reg g))\n        (goto (label sqrt-loop)))",
      "autoResize": true,
      "lineHeight": 1.25
    },
