      "isDeleted": true,
      "boundElements": null,
      "updated": 1785187601226,
      "link": null,
      "locked": false,
      "text": "\n\nStarting with n = 3\n\nStep 1\nn = 2\nval = \ncontinue = afterfib-n-1\nn stack = 3\nval stack = \ncontinue stack = fib-done\n\nStep 2\nn = 1\nval = \ncontinue = afterfib-n-1\nn stack = 3, 2\nval stack = \ncontinue stack = fib-done, afterfib-n-1\n\nStep 3\nn = 0\nval = 1\ncontinue = afterfib-n-2\nn stack = 3\nval stack = 1\ncontinue stack = fib-done, afterfib-n-1\n\nStep 4\nn = 1\nval = 2\ncontinue = fibe-done\nn stack =\nval stack = 1, 1\ncontinue stack =  fibe-done\n\nStep 5\nn = 1\nval = 2\ncontinue = fibe-done\nn stack =\nval stack = 1, 1\ncontinue stack =  fibe-done",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nStarting with n = 3\n\nStep 1\nn = 2\nval = \ncontinue = afterfib-n-1\nn stack = 3\nval stack = \ncontinue stack = fib-done\n\nStep 2\nn = 1\nval = \ncontinue = afterfib-n-1\nn stack = 3, 2\nval stack = \ncontinue stack = fib-done, afterfib-n-1\n\nStep 3\nn = 0\nval = 1\ncontinue = afterfib-n-2\nn stack = 3\nval stack = 1\ncontinue stack = fib-done, afterfib-n-1\n\nStep 4\nn = 1\nval = 2\ncontinue = fibe-done\nn stack =\nval stack = 1, 1\ncontinue stack =  fibe-done\n\nStep 5\nn = 1\nval = 2\ncontinue = fibe-done\nn stack =\nval stack = 1, 1\ncontinue stack =  fibe-done",
      "autoResize": true,
      "lineHeight": 1.25
    },
