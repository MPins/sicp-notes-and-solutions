      "updated": 1782043663638,
      "link": null,
      "locked": false,
      "text": "The innermost 'apply' now executes and matches the 'compound-procedure?' clause, yielding:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The innermost 'apply' now executes and matches the 'compound-procedure?' clause, yielding:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vi76gOy6dHYtM5LuyqbzK",
      "type": "text",
      "x": 384.0312500000001,
      "y": 1729.40625,
