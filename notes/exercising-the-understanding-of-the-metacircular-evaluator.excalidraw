      "versionNonce": 888560954,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782084767320,
      "link": null,
      "locked": false,
      "text": "(apply (eval-sequence '((lambda (y) (+ x y)))\n         (extend-environment '(x) '(3) the-global-environment))\n       '(4))",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(apply (eval-sequence '((lambda (y) (+ x y)))\n         (extend-environment '(x) '(3) the-global-environment))\n       '(4))",
