      "updated": 1781968242790,
      "link": null,
      "locked": false,
      "text": "To exercise our understanding of the metacircular evaluator, let’s run it step\nby step with the following input:\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To exercise our understanding of the metacircular evaluator, let’s run it step by step with the following input:\n\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "rmpaCHoQV6QJq92a3mBhE",
      "type": "text",
      "x": 402.5,
      "y": 247.5,
      "width": 451,
      "height": 25,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIA",
      "roundness": null,
      "seed": 639993747,
      "version": 134,
      "versionNonce": 1114830643,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782039085479,
      "link": null,
      "locked": false,
      "text": "(((lambda (x) (lambda (y) (+ x y))) 3) 4)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(((lambda (x) (lambda (y) (+ x y))) 3) 4)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oZzYgkHtkFCiJP6m-1BNR",
      "type": "text",
      "x": 355,
      "y": 329.5,
      "width": 777.933349609375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIB",
      "roundness": null,
      "seed": 997086355,
      "version": 369,
      "versionNonce": 1714061637,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781968332600,
      "link": null,
      "locked": false,
      "text": "\nOur input goes through all the initial clauses of the 'cond' in 'eval' before finally\nsatisfying the 'application?' clause, so we have:\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nOur input goes through all the initial clauses of the 'cond' in 'eval' before finally\nsatisfying the 'application?' clause, so we have:\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l94n3Xs2jr1ykuraD1JpB",
      "type": "text",
      "x": 372.5,
      "y": 446.5,
      "width": 825,
      "height": 50,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIC",
      "roundness": null,
      "seed": 184977725,
      "version": 290,
      "versionNonce": 1563251165,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782039098179,
      "link": null,
      "locked": false,
      "text": "(apply (eval '((lambda (x) (lambda (y) (+ x y))) 3) the-global-environment)\n       (list-of-values '(4) the-global-environment))",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(apply (eval '((lambda (x) (lambda (y) (+ x y))) 3) the-global-environment)\n       (list-of-values '(4) the-global-environment))",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tjJjupFWhzAvup_AFx2c6",
      "type": "text",
      "x": 348.63751220703125,
      "y": 520.5,
      "width": 446.9166564941406,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
