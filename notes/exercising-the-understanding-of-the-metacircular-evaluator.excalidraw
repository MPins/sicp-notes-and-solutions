      "link": null,
      "locked": false,
      "text": "Expanding 'cons' and 'make-frame', we obtain a new environment whose first frame binds x to 3:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expanding 'cons' and 'make-frame', we obtain a new environment whose first frame binds x to 3:",
