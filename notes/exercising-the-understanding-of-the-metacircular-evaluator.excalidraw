      "link": null,
      "locked": false,
      "text": "We now evaluate 'list-of-values', which is evaluated exactly as in the previous step and\ntherefore returns '(3). At the end of this step, we have:\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We now evaluate 'list-of-values', which is evaluated exactly as in the previous step and\ntherefore returns '(3). At the end of this step, we have:\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
