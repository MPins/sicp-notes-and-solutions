      "isDeleted": false,
      "boundElements": [],
      "updated": 1781968369829,
      "link": null,
      "locked": false,
      "text": "Next, 'list-of-values' is evaluated, and we get:\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Next, 'list-of-values' is evaluated, and we get:\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Crlb5Z57VkxXvDKxAmktd",
      "type": "text",
      "x": 371.4375,
      "y": 566,
      "width": 825,
      "height": 100,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIG",
      "roundness": null,
      "seed": 1493234795,
      "version": 486,
      "versionNonce": 541835283,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782039103248,
      "link": null,
      "locked": false,
      "text": "(apply (eval '((lambda (x) (lambda (y) (+ x y))) 3) the-global-environment)\n       (cons\n          (eval '4 the-global-environment)\n          (list-of-values '() the-global-environment)))",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(apply (eval '((lambda (x) (lambda (y) (+ x y))) 3) the-global-environment)\n       (cons\n          (eval '4 the-global-environment)\n          (list-of-values '() the-global-environment)))",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vLWLevPKlH2X3nClKUSny",
      "type": "text",
      "x": 369.4375,
      "y": 800,
      "width": 891,
      "height": 25,
      "angle": 0,
