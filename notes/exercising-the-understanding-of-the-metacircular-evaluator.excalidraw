      "isDeleted": false,
      "boundElements": [],
      "updated": 1781968509265,
      "link": null,
      "locked": false,
      "text": "Expanding the 'eval' contained in the output of the previous step, we once again reach the \n'application?' clause, yielding:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expanding the 'eval' contained in the output of the previous step, we once again reach the \n'application?' clause, yielding:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qUXDqfegYjng_aC2e34fZ",
      "type": "text",
      "x": 381.4375,
      "y": 979.96875,
      "width": 858,
