      "isDeleted": false,
      "boundElements": [],
      "updated": 1781968424673,
      "link": null,
      "locked": false,
      "text": "Inside 'cons', 'eval' falls through to the 'self-evaluating?' clause and returns 4.\nThis value is then combined with the result of 'list-of-values' applied to the\nempty list, which returns '(), yielding:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inside 'cons', 'eval' falls through to the 'self-evaluating?' clause and returns 4. This value is then combined with the result of 'list-of-values' applied to the empty list, which returns '(), yielding:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "84qFy6dzopZesgWYTZnTK",
      "type": "text",
      "x": 336.2458324432373,
