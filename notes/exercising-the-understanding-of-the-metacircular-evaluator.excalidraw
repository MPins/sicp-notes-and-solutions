      "isDeleted": false,
      "boundElements": [],
      "updated": 1782039118009,
      "link": null,
      "locked": false,
      "text": "(apply (apply (eval '(lambda (x) (lambda (y) (+ x y))) the-global-environment)\n              (list-of-values '(3) the-global-environment))\n        '(4))",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(apply (apply (eval '(lambda (x) (lambda (y) (+ x y))) the-global-environment)\n              (list-of-values '(3) the-global-environment))\n        '(4))",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
