    {
      "id": "bYjS7KgEZmR9_S5fJqih9",
      "type": "text",
      "x": 604,
      "y": 267.40625,
      "width": 837.566650390625,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
