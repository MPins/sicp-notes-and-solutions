    {
      "id": "gp9rJ0JBVtjnH__-D9Cur",
      "type": "text",
      "x": 1014.8125,
      "y": 1253.71875,
      "width": 521.4666748046875,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1k",
      "roundness": null,
      "seed": 698989136,
      "version": 1796,
      "versionNonce": 1492973932,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778172477009,
      "link": null,
      "locked": false,
      "text": "    (define (withdraw amount)\n        (if (>= balance amount)\n            (begin (set! balance (- balance amount))\n                    balance)\n            \"Insufficient funds\"))\n    (define (deposit amount)\n        (set! balance (+ balance amount))\n        balance)\n    (define (dispatch m)\n        (cond ((eq? m 'withdraw) withdraw)\n                ((eq? m 'deposit) deposit)\n                (else (error \"Unknown request: MAKE-ACCOUNT\" m))))\n    dispatch)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    (define (withdraw amount)\n        (if (>= balance amount)\n            (begin (set! balance (- balance amount))\n                    balance)\n            \"Insufficient funds\"))\n    (define (deposit amount)\n        (set! balance (+ balance amount))\n        balance)\n    (define (dispatch m)\n        (cond ((eq? m 'withdraw) withdraw)\n                ((eq? m 'deposit) deposit)\n                (else (error \"Unknown request: MAKE-ACCOUNT\" m))))\n    dispatch)",
      "autoResize": true,
      "lineHeight": 1.25
    },
