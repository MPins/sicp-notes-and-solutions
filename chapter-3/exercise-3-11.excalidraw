      "updated": 1778172983217,
      "link": null,
      "locked": false,
      "text": "parameters: 'deposit amount\nwithdraw:\n        (if (>= balance amount)\n            (begin (set! balance (- balance amount))\n                    balance)\n            \"Insufficient funds\"))\ndeposit:\n        (set! balance (+ balance amount))\n        balance)\ndispatch:\n        (cond ((eq? m 'withdraw) withdraw)\n                ((eq? m 'deposit) deposit)\n                (else (error \"Unknown request: MAKE-ACCOUNT\" m))))\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "parameters: 'deposit amount\nwithdraw:\n        (if (>= balance amount)\n            (begin (set! balance (- balance amount))\n                    balance)\n            \"Insufficient funds\"))\ndeposit:\n        (set! balance (+ balance amount))\n        balance)\ndispatch:\n        (cond ((eq? m 'withdraw) withdraw)\n                ((eq? m 'deposit) deposit)\n                (else (error \"Unknown request: MAKE-ACCOUNT\" m))))\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
