    {
      "id": "KahPBJvrOMQs-kRjW6fio",
      "type": "text",
      "x": 350,
      "y": 362,
      "width": 521.4666748046875,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1E",
      "roundness": null,
      "seed": 435643991,
      "version": 287,
      "versionNonce": 987783577,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778105388766,
      "link": null,
      "locked": false,
      "text": "(define (make-account balance)\n    (define (withdraw amount)\n        (if (>= balance amount)\n            (begin (set! balance (- balance amount))\n                    balance)\n            \"Insufficient funds\"))\n    (define (deposit amount)\n        (set! balance (+ balance amount))\n        balance)\n    (define (dispatch m)\n        (cond ((eq? m 'withdraw) withdraw)\n                ((eq? m 'deposit) deposit)\n                (else (error \"Unknown request: MAKE-ACCOUNT\" m))))\n    dispatch)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(define (make-account balance)\n    (define (withdraw amount)\n        (if (>= balance amount)\n            (begin (set! balance (- balance amount))\n                    balance)\n            \"Insufficient funds\"))\n    (define (deposit amount)\n        (set! balance (+ balance amount))\n        balance)\n    (define (dispatch m)\n        (cond ((eq? m 'withdraw) withdraw)\n                ((eq? m 'deposit) deposit)\n                (else (error \"Unknown request: MAKE-ACCOUNT\" m))))\n    dispatch)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
