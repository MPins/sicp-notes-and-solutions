    },
    {
      "id": "x6B-i0Vxg7ncE0aWXB-LM",
      "type": "text",
      "x": 313.7083435058594,
      "y": 889,
      "width": 261.6499938964844,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 1874924409,
      "version": 477,
      "versionNonce": 598107607,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778105531952,
      "link": null,
      "locked": false,
