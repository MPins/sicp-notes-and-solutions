    {
      "id": "uECmnSwhm2wr1E0DuBo-v",
      "type": "text",
      "x": 313.7083435058594,
      "y": 970.5,
      "width": 756.25,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
