      "link": null,
      "locked": false,
      "text": "Exercise 3.33: Using primitive multiplier, adder, and constant constraints,\ndefine a procedure averager that takes three connectors a, b, and c as\ninputs and establishes the constraint that the value of c is the average\nof the values of a and b.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exercise 3.33: Using primitive multiplier, adder, and constant constraints,\ndefine a procedure averager that takes three connectors a, b, and c as\ninputs and establishes the constraint that the value of c is the average\nof the values of a and b.",
      "autoResize": true,
      "lineHeight": 1.25
    },
