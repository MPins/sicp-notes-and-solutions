      "lineHeight": 1.25
    },
    {
      "id": "dTkcBM5I8Hnexh7fnAkhA",
      "type": "text",
      "x": 361.9499969482422,
      "y": 238,
      "width": 286.54998779296875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2M",
      "roundness": null,
      "seed": 1533673551,
      "version": 471,
      "versionNonce": 955056559,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777818933159,
      "link": null,
      "locked": false,
      "text": "(if (= n 1) 1 (* n (factorial (- n 1)))))",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(if (= n 1) 1 (* n (factorial (- n 1)))))",
