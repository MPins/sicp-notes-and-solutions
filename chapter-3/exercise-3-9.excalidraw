      "seed": 945118383,
      "version": 5,
      "versionNonce": 1767326977,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1777815610416,
      "link": null,
      "locked": false,
      "customData": {
        "generationData": {
          "status": "done",
          "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Factorial Procedure Analysis</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Fira+Code:wght@400;500&family=Inter:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n    <script src=\"https://unpkg.com/lucide@latest\"></script>\n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #0a0a0a;\n        }\n        .handwritten {\n            font-family: 'Architects Daughter', cursive;\n        }\n        .code-font {\n            font-family: 'Fira Code', monospace;\n        }\n        .glass-card {\n            background: rgba(23, 23, 23, 0.8);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        .glow-text {\n            text-shadow: 0 0 15px rgba(74, 222, 128, 0.3);\n        }\n    </style>\n</head>\n<body class=\"text-zinc-300 min-h-screen\">\n\n    <!-- Header / Navigation -->\n    <header class=\"border-b border-zinc-800 bg-zinc-950/50 sticky top-0 z-50\">\n        <nav class=\"max-w-5xl mx-auto px-6 h-16 flex items-center justify-between\">\n            <div class=\"flex items-center gap-2\">\n                <i data-lucide=\"binary\" class=\"text-green-500 w-6 h-6\"></i>\n                <span class=\"font-semibold tracking-tight text-white\">SICP_LABS</span>\n            </div>\n            <div class=\"hidden md:flex gap-8 text-sm font-medium\">\n                <a href=\"#\" class=\"hover:text-green-400 transition-colors\">Documentation</a>\n                <a href=\"#\" class=\"hover:text-green-400 transition-colors\">Recursion</a>\n                <a href=\"#\" class=\"hover:text-green-400 transition-colors\">Iteration</a>\n            </div>\n            <button class=\"bg-white text-black px-4 py-1.5 rounded-full text-sm font-medium hover:bg-zinc-200 transition-all\">\n                Run Analysis\n            </button>\n        </nav>\n    </header>\n\n    <main class=\"max-w-4xl mx-auto px-6 py-16 md:py-24\">\n        \n        <!-- Intro Section -->\n        <section class=\"mb-16\">\n            <p class=\"handwritten text-2xl md:text-3xl text-zinc-100 leading-relaxed max-w-2xl\">\n                To analyze two procedures for computing factorials, a recursive version:\n            </p>\n        </section>\n\n        <!-- Recursive Procedure Card -->\n        <section class=\"mb-20 group\">\n            <div class=\"flex items-center gap-3 mb-6\">\n                <div class=\"w-8 h-px bg-green-500/50\"></div>\n                <span class=\"text-xs uppercase tracking-[0.2em] font-bold text-green-500\">Recursive Definition</span>\n            </div>\n            \n            <div class=\"glass-card rounded-2xl p-8 md:p-12 transition-all duration-500 group-hover:border-green-500/30 group-hover:shadow-[0_0_40px_-15px_rgba(34,197,94,0.2)]\">\n                <pre class=\"code-font text-lg md:text-xl text-green-400 leading-relaxed glow-text overflow-x-auto\">\n(define (factorial n)\n  (if (= n 1) \n      1 \n      (* n (factorial (- n 1)))))</pre>\n            </div>\n            \n            <div class=\"mt-6 grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <div class=\"bg-zinc-900/50 p-4 rounded-xl border border-zinc-800\">\n                    <h4 class=\"text-white text-sm font-semibold mb-1 flex items-center gap-2\">\n                        <i data-lucide=\"layers\" class=\"w-4 h-4 text-zinc-500\"></i> Shape\n                    </h4>\n                    <p class=\"text-zinc-500 text-sm italic\">Linear expansion followed by contraction (Deferred operations).</p>\n                </div>\n                <div class=\"bg-zinc-900/50 p-4 rounded-xl border border-zinc-800\">\n                    <h4 class=\"text-white text-sm font-semibold mb-1 flex items-center gap-2\">\n                        <i data-lucide=\"cpu\" class=\"w-4 h-4 text-zinc-500\"></i> Complexity\n                    </h4>\n                    <p class=\"text-zinc-500 text-sm italic\">O(n) Space, O(n) Time.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Transition Text -->\n        <section class=\"mb-16\">\n            <p class=\"handwritten text-2xl md:text-3xl text-zinc-100 leading-relaxed\">\n                and an iterative version:\n            </p>\n        </section>\n\n        <!-- Iterative Procedure Card -->\n        <section class=\"mb-20 group\">\n            <div class=\"flex items-center gap-3 mb-6\">\n                <div class=\"w-8 h-px bg-blue-500/50\"></div>\n                <span class=\"text-xs uppercase tracking-[0.2em] font-bold text-blue-500\">Iterative Definition</span>\n            </div>\n            \n            <div class=\"glass-card rounded-2xl p-8 md:p-12 transition-all duration-500 group-hover:border-blue-500/30 group-hover:shadow-[0_0_40px_-15px_rgba(59,130,246,0.2)]\">\n                <pre class=\"code-font text-lg md:text-xl text-blue-400 leading-relaxed overflow-x-auto\">\n(define (factorial n)\n  (fact-iter 1 1 n))\n\n(define (fact-iter product counter max-count)\n  (if (> counter max-count)\n      product\n      (fact-iter (* counter product)\n                 (+ counter 1)\n                 max-count)))</pre>\n            </div>\n\n            <div class=\"mt-6 grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <div class=\"bg-zinc-900/50 p-4 rounded-xl border border-zinc-800\">\n                    <h4 class=\"text-white text-sm font-semibold mb-1 flex items-center gap-2\">\n                        <i data-lucide=\"refresh-cw\" class=\"w-4 h-4 text-zinc-500\"></i> Shape\n                    </h4>\n                    <p class=\"text-zinc-500 text-sm italic\">Constant space (Tail-call optimization).</p>\n                </div>\n                <div class=\"bg-zinc-900/50 p-4 rounded-xl border border-zinc-800\">\n                    <h4 class=\"text-white text-sm font-semibold mb-1 flex items-center gap-2\">\n                        <i data-lucide=\"database\" class=\"w-4 h-4 text-zinc-500\"></i> State\n                    </h4>\n                    <p class=\"text-zinc-500 text-sm italic\">Captured entirely in variables: product, counter, max.</p>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <footer class=\"border-t border-zinc-900 py-12 bg-zinc-950\">\n        <div class=\"max-w-4xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6\">\n            <div class=\"text-zinc-600 text-sm\">\n                &copy; 2023 Structure and Interpretation of Computer Programs\n            </div>\n            <div class=\"flex gap-6\">\n                <a href=\"#\" class=\"text-zinc-500 hover:text-white transition-colors\"><i data-lucide=\"github\" class=\"w-5 h-5\"></i></a>\n                <a href=\"#\" class=\"text-zinc-500 hover:text-white transition-colors\"><i data-lucide=\"twitter\" class=\"w-5 h-5\"></i></a>\n                <a href=\"#\" class=\"text-zinc-500 hover:text-white transition-colors\"><i data-lucide=\"book-open\" class=\"w-5 h-5\"></i></a>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Initialize Lucide icons\n        lucide.createIcons();\n    </script>\n</body>\n</html>"
        }
      }
    },
